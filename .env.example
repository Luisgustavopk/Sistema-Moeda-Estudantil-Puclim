# Compartilhado por Compose/backend. Os scripts criam .env com senhas aleatórias.
# Se editar manualmente, use NOME=valor sem aspas.
DB_NAME=puclim
DB_USER=puclim
DB_PASSWORD=change-me-local-user
# Mantemos o nome para compatibilidade: também define MARIADB_ROOT_PASSWORD no container.
MYSQL_ROOT_PASSWORD=change-me-local-root
DB_PORT=3307
# DB_ENGINE é escolhido automaticamente: Linux=mariadb; Windows=mysql.
# Para escolher manualmente, descomente uma das alternativas:
# DB_ENGINE=mariadb
# DB_ENGINE=mysql

# SMTP local (scripts e backend carregam este arquivo)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=puclim@localhost
MAIL_ZONE=America/Sao_Paulo
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false

# Nível mínimo para enviar e equipar um avatar GIF animado.
ANIMATED_AVATAR_LEVEL=5

# Recuperação de senha: origem pública do frontend usada nos links enviados.
PUBLIC_APP_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL=30m
PASSWORD_RESET_EMAIL_COOLDOWN=60s
PASSWORD_RESET_IP_WINDOW=15m
PASSWORD_RESET_IP_LIMIT=20
PASSWORD_RESET_DELIVERY_DELAY_MS=5000
