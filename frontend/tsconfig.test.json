{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "/src/*": ["./src/*"]
    }
  },
  "include": ["tests/**/*.ts", "playwright*.config.ts"]
}
